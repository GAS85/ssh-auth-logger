# You can set Time Zone to see logs with your local time
TZ=Europe/Berlin

# You can set to "console" (the default), "file" or "both".
#LOG_TO=console

# Specify log file path.
#LOG_FILE_PATH=/var/log/ssh-auth-logger.log

# Following are default values

# SSHD Part

# bits per second, emulate very slow connection
#SSHD_RATE=500

# Port and interface sshd to listen
#SSHD_BIND=:2222

# It's a secret key that is used to generate a deterministic hash value for a given host IP address
SSHD_KEY_KEY=Take me to your leader

# The minimum number of authentication attempts allowed
#SSHD_MAX_AUTH_TRIES=6

# If you use 'rsa' you can also set RSA key size, 2048, 3072, 4096 (very rare)
#SSHD_RSA_BITS=3072

# Can be 'remote_ip' (each remote IP gets its own profile, simulating per-attacker behavior.), or anything else for 'host' (the same local host always gets the same profile, e.g. binding to 0.0.0.0:22 will always select the same Profile).
#SSHD_PROFILE_SCOPE=host

# Send SSH Login Banner before Password prompt
#SSHD_SEND_BANNER=false

# Log Passwords as clear text or Base64 coded
#SSHD_LOG_CLEAR_PASSWORD=true

# Comma-separated list of allowed fields. 'msg', 'level' and 'time' can't be removed. Following combinations are possible: duser,src,spt,dst,dpt,client_version,server_version,password,keytype,fingerprint,server_key_type,destinationServicename,product
#LOG_FILTER=duser,src,spt,dst,dpt,client_version,server_version,password,keytype,fingerprint,server_key_type,destinationServicename,product,countryCode,abuseConfidenceScore,totalReports

# Force profile to use, please refer to serverProfiles in main.go. Possible values: dropbear, OpenSSH_7.4, OpenSSH_7.9, OpenSSH_8.2, OpenSSH_8.4, OpenSSH_9.6. THERE IS NO DEFAULT VALUE FOR IT, it is not set --> all Profiles are used.
#FORCE_SSH_PROFILE=dropbear

# Host key cache TTL to reduce CPU load by key generation from the same host. Default 24h.
#SSHD_HOST_KEY_CACHE_TTL=24h

# Cache cleanup interval. Default 1h.
#SSHD_HOST_KEY_CACHE_CLEANUP=1h

# Telnet Part

# Port and interface telnetd to listen
#TELNET_BIND=:2323

# Log Passwords as clear text or Base64 coded
#TELNET_LOG_CLEAR_PASSWORD=true

# bits per second, emulate very slow connection
#TELNET_RATE=100

###
# Abuse Common Setup
###

# Failures per IP before a report is sent.
# E.g. Blocklist requeues few logs entries and plus at least 20 symbols, so values below e.g. 5 can cause a reporting error by blocklist.de
ABUSE_REPORT_ATTEMPTS=10
# Cooldown per IP after a report. 15 minutes is a minimum. Please refer to Rate Limit in https://www.abuseipdb.com/api.html
ABUSE_REPORT_INTERVAL=15m
# How often stale IP state is purged
ABUSE_CLEANUP_INTERVAL=30m
# Interval when we will forget about IP's login attempts prior to report it. Also controls how long reputation check values will be cached if enabled.
ABUSE_STATE_EXPIRY=2h

###
# AbuseIPDB Part
###

# Enable Abuse IP DB reporting
ABUSEIPDB_ENABLED=false
# Your Abuse IP DB API Key. Get one after registration: https://www.abuseipdb.com/account/api/keys
ABUSEIPDB_API_KEY=someKey

# Optional values - AbuseIPDB

# SSH Report categories, please refer to https://www.abuseipdb.com/categories
ABUSEIPDB_SSH_CATEGORIES=18,22
# Telnet Report categories, please refer to https://www.abuseipdb.com/categories
ABUSEIPDB_TELNET_CATEGORIES=14,18,23
# Report User names to AbuseIPDB in a clear text
ABUSEIPDB_REPORT_CLEAR_USERNAME=false
# Report hashed Passwords to AbuseIPDB
ABUSEIPDB_REPORT_HASHED_PASSWORD=true
# Report Passwords to AbuseIPDB in a clear text. It is strongly recommended to use ABUSEIPDB_REPORT_HASHED_PASSWORD instead. Works only when report of hashed password is disabled
ABUSEIPDB_REPORT_CLEAR_PASSWORD=false
# Enable IP Reputation check and show it in logs in future connection attempt.
ABUSEIPDB_IP_CHECK=false

###
# DShield Part
###

# Enable DShield reporting
DSHIELD_ENABLED=false
# User ID, get it after registration: https://www.dshield.org/myaccount.html
DSHIELD_USERID=123456789
# Your API Key. Get one after registration: https://www.dshield.org/myaccount.html
DSHIELD_API_KEY=someKey

# Optional values - DShield

# Report queues the collected attempts and submits the batch once
DSHIELD_BATCH_SIZE=50
# Makes sure queued entries do not wait indefinitely for the batch to fill up.
DSHIELD_BATCH_INTERVAL=10m
# Use debug API instead of Production
DSHIELD_DEBUG=false
# Report User names to DShield in a clear text
DSHIELD_REPORT_CLEAR_USERNAME=true
# Report clear Passwords to DShield. DShield statistics are built from usernames / passwords, so unlike AbuseIPDB (public per-IP comments) clear credentials are on by default.
DSHIELD_REPORT_CLEAR_PASSWORD=true
# Report hashed Passwords to DShield.
DSHIELD_REPORT_HASHED_PASSWORD=false

###
# OTX Part
###

# Enable OTX reporting
OTX_ENABLED=false
# Your API Key. Get one after registration: https://otx.alienvault.com/settings
OTX_API_KEY=someKey
# The pulse ID is logged on creation.
# Set OTX_PULSE_ID to keep appending to it after a restart.
# Without it, each restart creates a new pulse.
OTX_PULSE_ID=pulse ID
# OTX Pulse Name
OTX_PULSE_NAME=GAS85/ssh-auth-logger honeypot SSH/Telnet brute-force sources

# Optional values - OTX

# Report queues the collected attempts and submits the batch once
OTX_BATCH_SIZE=50
# Makes sure queued entries do not wait indefinitely for the batch to fill up.
OTX_BATCH_INTERVAL=1h
# Accepts white, green, amber or red. Red more about in: https://www.cisa.gov/news-events/news/traffic-light-protocol-tlp-definitions-and-usage
OTX_TLP=white
# OTX_TLP set to amber and red need false
OTX_PUBLIC=true
# Tags as comma separated list
OTX_TAGS=honeypot,ssh,telnet,brute-force
# Role name. An unknown role could make OTX reject every batch.
OTX_INDICATOR_ROLE=bruteforce

###
# Blocklist Part
###

# Enable Blocklist reporting.
BLOCKLIST_ENABLED=false
# Required. Your e-mail or server ID. Get one after registration: https://www.blocklist.de/en/profile/server.html
BLOCKLIST_SERVER=1234
# Required. Your API Key. Get one after registration: https://www.blocklist.de/en/profile/server.html
BLOCKLIST_API_KEY=none

# Optional values - Blocklist

# Service tag for SSH. See Complete list of service names: https://www.blocklist.de/en/download.html#services
BLOCKLIST_SSH_SERVICE=ssh-auth
# Service tag for telnet. If empty, so Telnet is not reported.
# Block list has no service name for a telnet, you can use different one from SSH, just to separate it, or the same one.
BLOCKLIST_TELNET_SERVICE=bruteforcelogin
# Report User names to Blocklist in a clear text
BLOCKLIST_REPORT_CLEAR_USERNAME=true
# Report hashed Passwords to Blocklist
BLOCKLIST_REPORT_HASHED_PASSWORD=true
# Report Passwords to Blocklist in a clear text. It is strongly recommended to use BLOCKLIST_REPORT_HASHED_PASSWORD instead. Works only when report of hashed password is disabled.
BLOCKLIST_REPORT_CLEAR_PASSWORD=false

###
# Spamhaus Part
###

# Enable Spamhaus reporting.
SPAMHAUS_ENABLED=false
# Create it at https://auth.spamhaus.org/account/ under "API Key Creation". It is shown only once.
SPAMHAUS_API_KEY=none
# Please refer to https://submit.spamhaus.org/api/#threats-types
SPAMHAUS_THREAT_TYPE=attack
